# ─────────────────────────────────────────────
# TYPO3 Web Toolkit Demo Site
# connetation/t3wtk-sitepackage (and with it connetation/t3wtk-base + connetation/t3wtk-elements)
# is loaded via the Set dependencies in config.yaml.
# ─────────────────────────────────────────────

# The shared contact form (EXT:conn_t3wtk_sitepackage/Resources/Private/Forms/Contact.form.yaml)
# redirects to page uid 1 after submit — on the demo site that is not the demo root page.
# finishers.1 = Redirect.
plugin.tx_form.settings.formDefinitionOverrides.contact {
    finishers.1.options.pageUid = TEXT
    finishers.1.options.pageUid.data = site:rootPageId
}

# ─────────────────────────────────────────────
# Theme preview banner (Middleware/ThemeSwitcherMiddleware.php)
# ─────────────────────────────────────────────
# FLUIDTEMPLATE has no "if" property — the COA around it carries the condition.
page.5 = COA
page.5.if.isTrue.data = sitesettings:demosite.themeSwitcher.enabled
page.5.10 = FLUIDTEMPLATE
page.5.10 {
    templateName = Banner
    templateRootPaths.10 = EXT:conn_t3wtk_demosite/Resources/Private/Templates/ThemeSwitcher/
    dataProcessing.10 = conn-demosite-theme-switcher
    variables.position = TEXT
    variables.position.data = sitesettings:demosite.themeSwitcher.position
}

page.includeCSS.connDemoThemes = EXT:conn_t3wtk_demosite/Resources/Public/Css/theme-switcher.css
page.includeJSFooter.connDemoThemes = EXT:conn_t3wtk_demosite/Resources/Public/JavaScript/theme-switcher.js
page.includeJSFooter.connDemoThemes.defer = 1

# conn_t3wtk_base reads these settings as TypoScript constants, which the core
# caches without their values — read them at render time from the (possibly
# switched) site instead, so each theme gets its own.
page.bodyTagCObject.20.if.isTrue >
page.bodyTagCObject.20.if.isTrue.data = sitesettings:themeToggle.position
page.bodyTagCObject.30.if.isTrue >
page.bodyTagCObject.30.if.isTrue.data = sitesettings:theme.linkHoverEffect

page.headerData.20 = TEXT
page.headerData.20 {
    data = sitesettings:theme.light.bg
    wrap = <meta name="theme-color" content="|" media="(prefers-color-scheme: light)">
    htmlSpecialChars = 1
    required = 1
}
page.headerData.21 < page.headerData.20
page.headerData.21 {
    data = sitesettings:theme.dark.bg
    wrap = <meta name="theme-color" content="|" media="(prefers-color-scheme: dark)">
}

# Page template override: Default without the container's pb-5.
page.10.templateRootPaths.20 = EXT:conn_t3wtk_demosite/Resources/Private/Templates/Page/
